# =============================================================================
# fingerprint-browser / AI Browser Operator — 环境变量样例
# =============================================================================
# 用法：
#   cp .env.example .env        # 然后按注释填入真实值
# .env 已被 .gitignore 排除，绝不会入库。
#
# 图例：
#   [必需] 生产环境必须设置，缺失将导致功能不可用或数据安全风险
#   [推荐] 建议设置，不设则使用保守默认值
#   [可选] 调优 / 评测 / 调试专用，生产通常留空
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 服务基础
# -----------------------------------------------------------------------------
# HTTP 监听端口（server/index.js）
PORT=8787

# 运行环境。设为 production 时 policy.js 会收紧高风险动作的自动放行策略。
# 取值：development | production | test
NODE_ENV=development

# --- 安全边界（STEP 0.5）-----------------------------------------------------
# [共享部署必需] API 访问令牌。设置后所有 /api/* 请求必须携带：
#     Authorization: Bearer <token>  |  x-fpb-token: <token>  |  ?token=<token>（SSE 专用）
# 不设置 = 本地模式：仅接受 loopback 请求（含 Vite dev server 的 proxy 转发），
#           非 loopback 一律返回 403。
# ⚠️ 禁止「不设 token + 绑定 0.0.0.0」—— 启动自检会直接拒绝启动（除非 FPB_ALLOW_INSECURE=1）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FPB_API_TOKEN=

# 监听地址。默认 127.0.0.1（仅本机可访问）。
# 若需局域网 / 公网访问，必须同时设置 FPB_API_TOKEN。
FPB_BIND=127.0.0.1

# CORS 允许的来源，逗号分隔。留空 = 使用默认本机白名单（含 Vite dev server 5173）。
# 例：FPB_CORS_ORIGINS=https://fpb.example.com,https://ops.example.com
FPB_CORS_ORIGINS=

# 是否信任反向代理的 X-Forwarded-For（=1 时取最左跳判定客户端 IP）。
# 仅在确认部署于可信反代之后时开启；直接暴露时开启会导致来源伪造、绕过本机判定。
FPB_TRUST_PROXY=0

# 是否开放 /api/browser/:id/evaluate 远程 JS 执行（=1 开启，默认关闭）。
# ⚠️ 开启等于把浏览器会话的任意代码执行权交给调用方，仅限受控本机调试。
FPB_ALLOW_EVALUATE=0

# 是否允许在没有 FPB_MASTER_KEY 的情况下以一次性内存密钥启动（=1 允许）。
# ⚠️ 后果：进程重启后全部已存凭据永久不可解密。仅本机试用可接受。
FPB_ALLOW_EPHEMERAL_KEY=0

# 是否跳过启动期安全自检（=1 生效）。仅在完全清楚风险时使用，会让服务带病启动。
FPB_ALLOW_INSECURE=0

# --- 支付自动化授权（STEP 1 §7）--------------------------------------------
# 允许 autoPayment 放行「支付类动作」（purchase / payment）。
# ⚠️ 仅在 NODE_ENV=test 或本变量为 1 时生效；且**永远不会**放行
#    delete / password_change / update_account_settings（这些必须逐次人工审批）。
# 合法用途：用户在自己的授权环境中测试已获授权的购买流程。
# 禁止用途：绕过 CAPTCHA / 3DS / 风控 / 反欺诈 / 支付平台安全机制。
FPB_ALLOW_AUTOPAY=0


# -----------------------------------------------------------------------------
# 2. 主密钥 —— 凭据加密的根，全项目最高敏感级
# -----------------------------------------------------------------------------
# [必需] 用于 AES-256-GCM 加密落库的代理密码、站点凭据、支付凭据。
#
# ⚠️ 严重警告（对应审计项 SEC-02）：
#    不设置时 vault.js 会退化为「一次性随机内存密钥」并只打印一行 warn。
#    后果：进程重启后，此前落库的所有加密凭据永久无法解密，且不会报错，
#          表现为代理静默连不上、登录静默失败。
#    生产环境必须设置，且必须持久化备份到代码库之外。
#
# 要求：32 字节的 base64 字符串（44 个字符，以 = 结尾）
# 生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
#
FPB_MASTER_KEY=


# -----------------------------------------------------------------------------
# 3. AI Provider（Planner / Router 的大模型后端）
# -----------------------------------------------------------------------------
# [必需] Provider 选择。auto = 按已配置的 key 自动探测（openai → deepseek → mock）
# 取值：auto | openai | deepseek | mock
AI_PROVIDER=auto

# --- DeepSeek（当前主用，provider.js 优先探测）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- OpenAI（备选；未设 AI_PROVIDER 时，存在 OPENAI_API_KEY 会优先命中 openai）---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 通用别名：OPENAI_API_KEY 未设置时的兜底键名
AI_API_KEY=


# -----------------------------------------------------------------------------
# 4. 存储
# -----------------------------------------------------------------------------
# 存储后端。仅支持 json | sqlite，其它值会抛错启动失败。
#   json   —— 默认，文件位于 server/data/*.json（零依赖，适合单机与开发）
#   sqlite —— 位于 STORE_SQLITE_PATH，适合数据量增大后迁移
STORE_DRIVER=json

# sqlite 驱动下的数据库文件路径。默认 server/data/agent.sqlite
STORE_SQLITE_PATH=


# -----------------------------------------------------------------------------
# 5. 安全策略
# -----------------------------------------------------------------------------
# [可选] 高风险动作（购买 / 支付 / 删除 / 改密）的自动放行开关。
# 设为 1 时 policy.js 允许 Agent 在无人确认下执行 CRITICAL 风险动作。
# ⚠️ 生产环境强烈建议保持注释/留空；仅在受控的自动化场景开启。
# FPB_ALLOW_AUTOPAY=1


# -----------------------------------------------------------------------------
# 6. 超时与性能调优
# -----------------------------------------------------------------------------
# 单个浏览器操作（click / fill / type 等）的超时上限，毫秒。
# 同时作用于 tools.js 与 browserManager.js 的 humanType / humanClick 总时长闸门。
TOOL_OP_TIMEOUT_MS=25000

# VIL（Verification Intelligence Layer）观察窗口最大时长，毫秒。
# 窗口内对 DOM_CHANGED / STATE_UNKNOWN 等做重观察与重验证。
VIL_WINDOW_MAX_MS=5200

# 页面原生对话框（alert / confirm / prompt）的自动关闭超时，毫秒。
DIALOG_AUTO_DISMISS_MS=8000

# 浏览器内核选择。设为 1 时强制使用 Playwright 自带 Chromium；
# 不设时优先使用系统已安装的 Chrome。
# BENCH_PW_CHROMIUM=1

# SOCKS5 代理跳板（格式 host:port）。用于需要多级代理的网络环境。
# 显式设置后 browserManager 会跳过代理可达性预检。
# SOCKS5_HOP=


# -----------------------------------------------------------------------------
# 7. 评测 / Gate / 回归（仅研发与 CI 使用）
# -----------------------------------------------------------------------------
# 4-task gate 相关
# GATE_TASKS_FILE=server/scripts/gate_tasks.example.json
# GATE_TASK_IDS=saas.login,ecommerce.add_to_cart,data_entry.basic,real-world.rw.001
# GATE_MOCK_BASE=http://localhost:3000
# GATE_TASK_TIMEOUT_MS=180000
# GATE_VERBOSE=1
# GATE_DUMP=1

# 凭据注入（credential_reseed.js）
# GATE_PROFILE_ID=
# GATE_SITE=gate
# GATE_SECRETS_FILE=
# GATE_EMAIL=
# GATE_PASSWORD=
# GATE_CARD_NUMBER=
# GATE_CARD_EXP_MONTH=
# GATE_CARD_EXP_YEAR=
# GATE_CARD_CVV=
# GATE_CARD_NAME=

# 代理自检（selfcheck.js 的位置参数亦可传入）
# SELFCHECK_PROXY=socks5://user:pass@host:port


# -----------------------------------------------------------------------------
# 8. 调试诊断（默认全部关闭）
# -----------------------------------------------------------------------------
# Planner 提示词与决策过程打印
# PLANNER_DEBUG=1

# 修复链路孤儿 repairAttempt 诊断
# E3_1_DIAG=1

# runtime repair 分支进入点诊断
# E4_DIAG=1

# Phase 9 P3 / P4 用例与调试输出
# P3_CASES=BCD
# P3_DEBUG=1
# P4_DEBUG=1

# 分析脚本读取的历史 store 目录
# PHASE68_STORE=
