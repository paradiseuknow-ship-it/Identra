{
  "name": "fingerprint-browser",
  "version": "0.2.0-rc1",
  "private": true,
  "description": "指纹浏览器 - 多账号隔离与管理，基于 Chromium 内核的指纹伪装方案 (MVP)",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix client install",
    "start": "node server/index.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "test": "node server/scripts/runRegression.js",
    "test:verbose": "node server/scripts/runRegression.js --verbose",
    "test:only": "node server/scripts/runRegression.js --only"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.47.2",
    "socks": "^2.8.9"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
